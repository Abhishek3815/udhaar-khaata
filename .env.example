# GEMINI_API_KEY: Required for Gemini AI voice smart processing.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# HOSTING & SERVER CONFIGURATION
# ==========================================
PORT=3000
HOST="0.0.0.0"

# ==========================================
# MYSQL DATABASE CONFIGURATION
# Dukandar / Developer: Apne MySQL server ki details yaha dalein.
# Agar MySQL host nahi hai to app automatically built-in secure storage
# use karegi bina crash hue.
# ==========================================
DB_TYPE="mysql"
MYSQL_HOST="localhost"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="dukaan_khaata_db"
MYSQL_SSL="false"

# ==========================================
# DUKAAN / SHOP DETAILS
# ==========================================
SHOP_NAME="श्री गणेश किराना एवं जनरल स्टोर"
SHOP_OWNER="दुकानदार"
SHOP_PHONE="9876543210"
